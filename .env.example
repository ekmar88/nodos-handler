# Hostname or IP address of the machine running Nodos.
NODOS_HOST=127.0.0.1
# EditorService: graph discovery and pin writes (required).
NODOS_EDITOR_PORT=50052
# AppService: only used by POST /api/nodes/:id/dirty. Set NODOS_APP_SERVICE=false to skip it.
NODOS_PORT=50053
NODOS_APP_SERVICE=true
NODOS_APP_KEY=nodos-backend-app
NODOS_APP_NAME="Nodos Backend Controller"

# cache: serve reads from the live stream (fast). fresh: new engine snapshot per read (slow).
NODOS_READ_MODE=cache
# Full background resync from a fresh snapshot, in ms (0 disables).
NODOS_RESYNC_MS=10000
# Reconnection backoff bounds, in ms.
NODOS_RECONNECT_MIN_MS=1000
NODOS_RECONNECT_MAX_MS=30000

# REST API bind address and port.
HOST=127.0.0.1
PORT=3000
# Optional shared secret. When set, /api requires the X-API-Key header (or ?api_key=).
API_KEY=
CORS_ORIGIN=*
# debug | info | warn | error | silent
LOG_LEVEL=info
