{
  "name": "nodos-backend",
  "version": "1.1.0",
  "description": "Express backend to browse and control Nodos nodes (EditorService over gRPC/FlatBuffers)",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "src/app.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "probe": "node scripts/probe-ports.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "express": "^4.21.0",
    "flatbuffers": "^25.9.23"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
